# Copy to .env.local and fill in to enable quote/spring email delivery.
# Until RESEND_API_KEY is set, form submissions are accepted and logged
# server-side but not emailed (the site still works).

# Resend API key — create at https://resend.com and verify your sending domain.
RESEND_API_KEY=

# Verified "From" address for outgoing quote emails.
# Must be on a domain you've verified in Resend.
QUOTE_FROM_EMAIL="Doors Direct Website <quotes@doorsdirectsouth.com>"
